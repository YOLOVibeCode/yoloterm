<Window x:Class="YOLOTerm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YOLOTerm.App"
        mc:Ignorable="d"
        Title="YOLOTerm" Height="600" Width="1000"
        Background="#1e1e1e"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Tab Strip -->
        <Grid Grid.Row="0" x:Name="TabStripContainer"/>
        
        <!-- Content Area -->
        <Grid Grid.Row="1" x:Name="ContentContainer">
            <!-- TilingPanel and tabs will be added programmatically -->
        </Grid>
        
        <!-- Find Bar -->
        <Grid Grid.Row="2" x:Name="FindBarContainer"/>
    </Grid>
</Window>
