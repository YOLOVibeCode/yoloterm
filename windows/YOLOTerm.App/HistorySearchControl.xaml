<UserControl x:Class="YOLOTerm.App.HistorySearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2d2d2d"
             BorderBrush="#3e3e3e"
             BorderThickness="1">
    
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#3e3e3e"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3e3e3e"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderBrush" Value="#3e3e3e"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0e639c"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Search box and options -->
        <Grid Grid.Row="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="SearchBox" Grid.Column="0" 
                         TextChanged="SearchBox_TextChanged"
                         KeyDown="SearchBox_KeyDown"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="PreviousButton" Content="↑" Width="32" Click="PreviousButton_Click" ToolTip="Previous (Shift+Enter)"/>
                    <Button x:Name="NextButton" Content="↓" Width="32" Margin="4,0,0,0" Click="NextButton_Click" ToolTip="Next (Enter)"/>
                    <Button x:Name="CloseButton" Content="×" Width="32" Margin="4,0,0,0" Click="CloseButton_Click" ToolTip="Close (Esc)"/>
                </StackPanel>
            </Grid>
            
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox x:Name="OnlyFailedCheckBox" Content="Failed only" Foreground="#cccccc" Margin="0,0,12,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
                <CheckBox x:Name="OnlyFavoritesCheckBox" Content="Favorites only" Foreground="#cccccc" Margin="0,0,12,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
                <TextBlock x:Name="ResultsCountLabel" Text="0 results" Foreground="#999999" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Grid>
        
        <!-- Results list -->
        <ListBox x:Name="ResultsListBox" Grid.Row="1" Margin="8,0,8,8"
                 SelectionChanged="ResultsListBox_SelectionChanged"
                 MouseDoubleClick="ResultsListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding CommandText}" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Foreground="#999999" FontSize="11">
                                <Run Text="{Binding Shell}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding Cwd}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding TimestampFormatted}"/>
                            </TextBlock>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <TextBlock Text="{Binding ExitCodeFormatted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding DurationFormatted}" Foreground="#999999" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!-- Status bar -->
        <Border Grid.Row="2" Background="#252526" BorderBrush="#3e3e3e" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock x:Name="StatusLabel" Text="Type to search command history" Foreground="#999999" FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
