<Window x:Class="YOLOTerm.App.GlobalHistorySearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YOLOTerm.App"
        Title="Search Command History"
        Width="800"
        Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e">
    
    <Grid>
        <local:HistorySearchControl x:Name="SearchControl" 
                                     CommandSelected="SearchControl_CommandSelected"
                                     CloseRequested="SearchControl_CloseRequested"/>
    </Grid>
</Window>
