<Window x:Class="YOLOTerm.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YOLOTerm Settings"
        Width="700"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1e1e1e">
    
    <Window.Resources>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#3e3e3e"/>
        </Style>
        
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0e639c"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TabControl Grid.Row="0" x:Name="SettingsTabs">
            <!-- Appearance Tab -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Label Content="Theme" FontWeight="Bold"/>
                        <ComboBox x:Name="ThemeComboBox" Width="300" HorizontalAlignment="Left" Margin="0,4,0,12"/>
                        
                        <Label Content="Font Family" FontWeight="Bold" Margin="0,8,0,0"/>
                        <ComboBox x:Name="FontFamilyComboBox" Width="300" HorizontalAlignment="Left" Margin="0,4,0,12"/>
                        
                        <Label Content="Font Size" FontWeight="Bold" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                            <ComboBox x:Name="FontSizeComboBox" Width="100"/>
                            <TextBlock Text="Affects all terminal panes" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        
                        <Label Content="Window Opacity" FontWeight="Bold" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                            <Slider x:Name="OpacitySlider" Width="200" Minimum="0.5" Maximum="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock x:Name="OpacityLabel" Text="100%" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Behavior Tab -->
            <TabItem Header="Behavior">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Label Content="Default Shell" FontWeight="Bold"/>
                        <ComboBox x:Name="DefaultShellComboBox" Width="300" HorizontalAlignment="Left" Margin="0,4,0,12"/>
                        
                        <Label Content="Startup Behavior" FontWeight="Bold" Margin="0,8,0,0"/>
                        <RadioButton x:Name="StartupRestoreRadio" Content="Restore previous session" GroupName="Startup" Margin="0,4" Foreground="#cccccc"/>
                        <RadioButton x:Name="StartupEmptyRadio" Content="Start with empty tab" GroupName="Startup" Margin="0,4" Foreground="#cccccc"/>
                        <RadioButton x:Name="StartupCustomRadio" Content="Run custom command" GroupName="Startup" Margin="0,4,0,8" Foreground="#cccccc"/>
                        <TextBox x:Name="CustomStartupCommandTextBox" Width="400" HorizontalAlignment="Left" Margin="20,0,0,12"/>
                        
                        <Label Content="Close Window" FontWeight="Bold" Margin="0,8,0,0"/>
                        <RadioButton x:Name="CloseConfirmRadio" Content="Ask for confirmation" GroupName="CloseWindow" Margin="0,4" Foreground="#cccccc"/>
                        <RadioButton x:Name="CloseAlwaysRadio" Content="Close immediately" GroupName="CloseWindow" Margin="0,4" Foreground="#cccccc"/>
                        <RadioButton x:Name="CloseMinimizeRadio" Content="Minimize to tray" GroupName="CloseWindow" Margin="0,4,0,12" Foreground="#cccccc"/>
                        
                        <Label Content="Scrollback Lines" FontWeight="Bold" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                            <ComboBox x:Name="ScrollbackComboBox" Width="150"/>
                            <TextBlock Text="Number of lines to keep in buffer" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Keybindings Tab -->
            <TabItem Header="Keybindings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Keyboard shortcuts are configured globally and cannot be customized per-tab." Margin="0,0,0,12"/>
                        
                        <Label Content="Clipboard" FontWeight="Bold"/>
                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Copy (with selection):" Foreground="#cccccc" Margin="0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Ctrl+C" Margin="12,4"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Copy (force):" Foreground="#cccccc" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Ctrl+Shift+C" Margin="12,4"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Paste:" Foreground="#cccccc" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Ctrl+V" Margin="12,4"/>
                        </Grid>
                        
                        <Label Content="Tabs" FontWeight="Bold" Margin="0,8,0,0"/>
                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="New Tab:" Foreground="#cccccc" Margin="0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Ctrl+T" Margin="12,4"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Close Tab:" Foreground="#cccccc" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Ctrl+W" Margin="12,4"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Next Tab:" Foreground="#cccccc" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Ctrl+Tab" Margin="12,4"/>
                        </Grid>
                        
                        <Label Content="Panes" FontWeight="Bold" Margin="0,8,0,0"/>
                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Split Right:" Foreground="#cccccc" Margin="0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Ctrl+Shift+D" Margin="12,4"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Split Down:" Foreground="#cccccc" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Ctrl+Shift+E" Margin="12,4"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Focus Pane:" Foreground="#cccccc" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Alt+Arrow Keys" Margin="12,4"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- History Tab -->
            <TabItem Header="History">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <CheckBox x:Name="HistoryEnabledCheckBox" Content="Enable command history" Margin="0,0,0,12"/>
                        
                        <Label Content="Retention Period" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                            <ComboBox x:Name="HistoryRetentionComboBox" Width="150"/>
                            <TextBlock Text="Commands older than this will be automatically deleted" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        
                        <CheckBox x:Name="HistoryRedactionCheckBox" Content="Enable privacy redaction (recommended)" Margin="0,8,0,4"/>
                        <TextBlock Text="Automatically redacts passwords, tokens, and other sensitive data from command history" Margin="24,0,0,12"/>
                        
                        <CheckBox x:Name="HistorySyncCheckBox" Content="Sync history across panes" Margin="0,8,0,4"/>
                        <TextBlock Text="Share command history between all panes in the same tab" Margin="24,0,0,12"/>
                        
                        <Button x:Name="ClearHistoryButton" Content="Clear All History" Width="150" HorizontalAlignment="Left" Margin="0,16,0,0" Click="ClearHistoryButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Shell Integration Tab -->
            <TabItem Header="Shell Integration">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Shell integration enables advanced features like command history with exit codes, duration tracking, and current directory reporting." Margin="0,0,0,12"/>
                        
                        <CheckBox x:Name="ShellIntegrationCheckBox" Content="Enable shell integration" Margin="0,0,0,16"/>
                        
                        <Label Content="Detected Shells" FontWeight="Bold"/>
                        <ListBox x:Name="ShellsListBox" Height="200" Background="#2d2d2d" BorderBrush="#3e3e3e" Foreground="#cccccc" Margin="0,4,0,12"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                            <Button x:Name="InstallPluginButton" Content="Install Plugin" Width="120" Margin="0,0,8,0" Click="InstallPluginButton_Click"/>
                            <Button x:Name="UninstallPluginButton" Content="Uninstall Plugin" Width="120" Margin="0,0,8,0" Click="UninstallPluginButton_Click"/>
                            <Button x:Name="RefreshShellsButton" Content="Refresh" Width="100" Click="RefreshShellsButton_Click"/>
                        </StackPanel>
                        
                        <TextBlock Text="Note: You must restart your shell after installing or uninstalling plugins." Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Advanced Tab -->
            <TabItem Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Label Content="Terminal Behavior" FontWeight="Bold"/>
                        <CheckBox x:Name="EnableBellCheckBox" Content="Enable terminal bell" Margin="0,4"/>
                        <CheckBox x:Name="CopyOnSelectCheckBox" Content="Copy on select" Margin="0,4"/>
                        <CheckBox x:Name="PasteOnRightClickCheckBox" Content="Paste on right-click" Margin="0,4,0,12"/>
                        <CheckBox x:Name="TrimWhitespaceCheckBox" Content="Trim trailing whitespace on copy" Margin="0,4,0,12"/>
                        
                        <Label Content="Cursor" FontWeight="Bold" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Label Content="Style:" Width="80"/>
                            <ComboBox x:Name="CursorStyleComboBox" Width="150"/>
                        </StackPanel>
                        <CheckBox x:Name="CursorBlinkCheckBox" Content="Cursor blink" Margin="0,4,0,12"/>
                        
                        <Label Content="Debugging" FontWeight="Bold" Margin="0,8,0,0"/>
                        <CheckBox x:Name="DebugLoggingCheckBox" Content="Enable debug logging" Margin="0,4,0,4"/>
                        <TextBlock Text="Logs will be written to %LOCALAPPDATA%\YOLOTerm\logs\" Margin="24,0,0,12"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        
        <!-- Bottom buttons -->
        <Grid Grid.Row="1" Background="#2d2d2d" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="Save" Width="100" Margin="0,0,8,0" Click="SaveButton_Click"/>
                <Button x:Name="CancelButton" Content="Cancel" Width="100" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
